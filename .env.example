# Reverse-image search. Required for the web/social discovery stage.
SERPAPI_API_KEY=
# A public HTTPS URL pointing to the same image supplied with --image.
# Google Lens needs an externally fetchable image; host a consented demo image first.
SOURCE_IMAGE_URL=
# Required only for --camera or when no --source-url is supplied. Create a free
# API key at imgbb.com; the captured image becomes publicly accessible to Lens.
IMGBB_API_KEY=  

# Blockchain: local recording defaults after `npm run node`.
RPC_URL=http://127.0.0.1:8545
REGISTRY_ADDRESS=
# Use a Hardhat test-account key locally, or a funded testnet key for Amoy.
DEPLOYER_PRIVATE_KEY=
